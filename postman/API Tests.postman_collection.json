  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "pm.test(\"Status code é 200\", function () {\r",
          "    pm.response.to.have.status(200)\r",
          "});\r",
          "\r",
          "pm.test(\"Resposta contem access_token\", function () {\r",
          "    var jsonData = pm.response.json();\r",
          "    pm.expect(jsonData).to.have.property(\"access_token\");\r",
          "    pm.environment.set(\"accesss_token\", jsonData.access_token);\r",
          "});\r",
          "\r",
          "pm.test(\"Status code é 400 (erro esperado)\", function () {\r",
          "    pm.response.to.have.status(400);\r",
          "});\r",
          "\r",
          "pm.test(\"Mensagem de erro é Credenciais de acesso erradas\", function () {\r",
          "    var jsonData = pm.response.json();\r",
          "    pm.expect(jsonData.msg).to.include(\"Invalid login credentials\");\r",
          "})"
        ],
        "type": "text/javascript"
      }
    }
  ]
